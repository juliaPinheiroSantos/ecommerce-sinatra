# Copie este arquivo para ".env" antes de rodar a aplicação:
#   cp .env.example .env        (Linux/Mac/WSL)
#   copy .env.example .env      (Windows)
#
# O arquivo .env não é versionado (está no .gitignore).
# Gere um valor próprio para SESSION_SECRET com:
#   ruby -rsecurerandom -e "puts SecureRandom.hex(64)"
SESSION_SECRET=troque_este_valor_por_uma_string_aleatoria_e_unica
