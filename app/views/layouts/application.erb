<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-commerce Web</title>
</head>
<body>
  
  <header>
    <h1>E-commerce</h1>
    <nav>
      <% if logged_in? %>
        <p>Olá, <%= current_user.nome %>!</p>
        <a href="/">Início</a> | 
        <a href="/logout">Sair</a>
      <% else %>
        <a href="/login">Login</a> | 
        <a href="/cadastro">Cadastro</a>
      <% end %>
    </nav>
  </header>

  <hr>

  <main>
    <%= yield %>
  </main>

  <hr>

  <footer>
    <p>&copy; 2026 - Aplicação Web E-commerce</p>
  </footer>

</body>
</html>