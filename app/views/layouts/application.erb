<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Doçuras da Thalita</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  
  <header>
    <h1>Doçuras da Thalita</h1>
    <nav>
      <% if logged_in? %>
        <p>Bem-vindo(a), <a href="/perfil" style="color: var(--brand-pink);"><%= current_user.nome %></a>!</p>
        <a href="/">Início</a> | 
        <a href="/produtos">Produtos</a> | 
        
        <% if current_user.vendedor? %>
          <a href="/vendas">Gestão de Pedidos</a> |
        <% else %>
          <a href="/compras">Minhas Compras</a> | 
          <a href="/carrinho" style="color: var(--brand-pink);">Carrinho (<%= quantidade_itens_no_carrinho %>)</a> | 
        <% end %>
        
        <a href="/logout">Sair</a>
      <% else %>
        <a href="/">Início</a> | 
        <a href="/produtos">Produtos</a> | 
        <a href="/login">Entrar</a> | 
        <a href="/cadastro">Cadastrar</a>
      <% end %>
    </nav>
  </header>

  <main>
    <%= render_flash %>
    <%= yield %>
  </main>

  <footer>
    <p>&copy; 2026 - Doçuras da Thalita | Programação Web</p>
  </footer>

</body>
</html>