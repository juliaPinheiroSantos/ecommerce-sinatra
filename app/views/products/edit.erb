<div class="auth-card" style="max-width: 500px;">
  <h2>Editar Produto</h2>

  <form action="/produtos/<%= @produto.id %>" method="POST">
    <div class="form-group">
      <label>Nome do Produto</label>
      <input type="text" name="nome" value="<%= @produto.nome %>" required>
    </div>

    <div class="form-group">
      <label>Descrição</label>
      <textarea name="descricao" rows="3" style="width: 100%; padding: 12px; border: 2px solid #fad2d9; border-radius: 8px; box-sizing: border-box; font-family: 'Poppins', sans-serif; resize: vertical;"><%= @produto.descricao %></textarea>
    </div>

    <div style="display: flex; gap: 15px;">
      <div class="form-group" style="flex: 1;">
        <label>Preço (R$)</label>
        <input type="number" name="preco" step="0.01" min="0.01" value="<%= @produto.preco.to_f %>" required>
      </div>

      <div class="form-group" style="flex: 1;">
        <label>Estoque Atual</label>
        <input type="number" name="estoque" step="1" min="0" value="<%= @produto.estoque %>" required>
      </div>
    </div>

    <button type="submit" class="btn-primary">Salvar Alterações</button>
  </form>
  
  <div class="auth-links">
    <p><a href="/produtos/<%= @produto.id %>">&larr; Cancelar e voltar</a></p>
  </div>
</div>