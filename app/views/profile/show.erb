<div class="auth-card" style="max-width: 500px;">
  <h2>Meu Perfil</h2>

  <div class="form-group">
    <label>Nome Completo</label>
    <p style="margin-top: 5px; font-size: 1.1rem;"><%= current_user.nome %></p>
  </div>

  <div class="form-group">
    <label>E-mail (Login)</label>
    <p style="margin-top: 5px; color: #666;"><%= current_user.email %></p>
  </div>

  <div class="form-group">
    <label>CPF</label>
    <p style="margin-top: 5px;"><%= current_user.cpf %></p>
  </div>

  <div class="form-group">
    <label>Telefone</label>
    <p style="margin-top: 5px;"><%= current_user.telefone || "Não informado" %></p>
  </div>

  <a href="/perfil/editar" class="btn-primary" style="display: block; text-decoration: none; box-sizing: border-box; margin-top: 25px;">Editar Meus Dados</a>
</div>