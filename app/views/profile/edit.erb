<div class="auth-card" style="max-width: 500px;">
  <h2>Editar Perfil</h2>

  <% if @erros %>
    <div class="alert-error">
      <ul>
        <% @erros.each do |erro| %>
          <li><%= erro %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <form action="/perfil/editar" method="POST">
    <div class="form-group">
      <label>Nome Completo</label>
      <input type="text" name="nome" value="<%= current_user.nome %>" required>
    </div>

    <div class="form-group">
      <label>E-mail</label>
      <input type="email" value="<%= current_user.email %>" disabled style="background-color: #f9f9f9; color: #999; border-color: #eee;">
      <small style="color: #888;">O e-mail de acesso não pode ser alterado.</small>
    </div>

    <div class="form-group">
      <label>CPF</label>
      <input type="text" name="cpf" value="<%= current_user.cpf %>" required>
    </div>

    <div class="form-group">
      <label>Telefone</label>
      <input type="text" name="telefone" value="<%= current_user.telefone %>">
    </div>

    <div class="form-group">
      <label>Nova Senha</label>
      <input type="password" name="password" placeholder="Deixe em branco para manter a atual">
    </div>

    <button type="submit" class="btn-primary">Salvar Alterações</button>
  </form>
  
  <div class="auth-links">
    <p><a href="/perfil">← Voltar sem salvar</a></p>
  </div>
</div>