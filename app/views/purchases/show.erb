<div class="auth-card" style="max-width: 700px; text-align: left; margin: 20px auto;">
  <a href="/compras" style="color: var(--brand-burgundy); text-decoration: none; font-weight: bold;">&larr; Voltar para Meus Pedidos</a>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 20px; border-bottom: 2px solid var(--brand-pink); padding-bottom: 10px;">
    <h2 style="font-family: 'Dancing Script', cursive; color: var(--brand-burgundy); font-size: 2.5rem; margin: 0;">
      Pedido #<%= @compra.id %>
    </h2>
    <span style="background-color: var(--brand-light-pink); color: var(--brand-burgundy); padding: 5px 15px; border-radius: 12px; font-weight: bold;">
      <%= traduzir_status(@compra.status) %>
    </span>
  </div>

  <p style="color: #666; font-size: 0.9rem; margin-top: 10px;">
    Realizado em: <%= formatar_data(@compra.data) %>
  </p>

  <h3 style="color: var(--brand-burgundy); margin-top: 30px;">Itens do Pedido</h3>
  
  <ul style="list-style: none; padding: 0; margin: 0;">
    <% @itens.each do |item| %>
      <li style="display: flex; justify-content: space-between; padding: 15px 0; border-bottom: 1px dashed #fad2d9;">
        <div>
          <span style="font-weight: bold; color: var(--text-dark);"><%= item.quantidade %>x</span> 
          <%= item.produto.nome %>
        </div>
        <div style="font-weight: bold;">
          <%= formatar_moeda(item.preco_unitario * item.quantidade) %>
        </div>
      </li>
    <% end %>
  </ul>

  <div style="text-align: right; margin-top: 20px; font-size: 1.3rem;">
    <strong>Total: <span style="color: var(--brand-pink);"><%= formatar_moeda(@compra.valor_total) %></span></strong>
  </div>

  <div style="margin-top: 40px; text-align: center;">
    <% if @compra.status == 'pendente' %>
      <p style="font-size: 0.85rem; color: #666; margin-bottom: 15px;">Ainda dá tempo de mudar de ideia antes do pagamento ser confirmado.</p>
      <form action="/compras/<%= @compra.id %>/cancelar" method="POST" onsubmit="return confirm('Tem certeza que deseja cancelar esta compra?');">
        <button type="submit" style="background-color: #c91e36; color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; font-family: 'Poppins', sans-serif;">
          Cancelar Minha Compra
        </button>
      </form>
    <% elsif @compra.status == 'cancelada' %>
      <p style="color: #c91e36; font-weight: bold; padding: 10px; background-color: #ffeef0; border-radius: 8px;">Este pedido foi cancelado.</p>
    <% elsif @compra.status == 'entregue' %>
      <p style="color: #1e8e3e; font-weight: bold; padding: 10px; background-color: #e6f4ea; border-radius: 8px;">Este pedido já foi entregue.</p>
    <% else %>
      <p style="color: #1e8e3e; font-weight: bold; padding: 10px; background-color: #e6f4ea; border-radius: 8px;">Este pedido já está sendo preparado e não pode mais ser cancelado.</p>
    <% end %>
  </div>
</div>